# Скопируйте в .env и впишите свои ключи: cp .env.example .env
OPENAI_API_KEY=sk-...
# Для третьего маршрута: GPT-перевод + ElevenLabs TTS.
ELEVENLABS_API_KEY=sk_...
# Необязательно: свои voice IDs. Без них используются встроенные Antoni/Rachel.
# ELEVENLABS_MALE_VOICE_ID=
# ELEVENLABS_FEMALE_VOICE_ID=
# Для удалённого личного VPS. То же значение задайте в UVT_API_TOKEN
# в browser/uvt.user.js; для localhost оставьте значение пустым.
UVT_API_TOKEN=replace-with-a-long-random-secret
# Публичные HTTPS origins трёх reverse-proxy маршрутов.
# Нужны, чтобы вкладки Free/GPT/ElevenLabs в dashboard работали через Caddy.
# Указывайте только origin без пути, query и fragment.
# UVT_FREE_PUBLIC_URL=https://free.uvt.example
# UVT_GPT_PUBLIC_URL=https://cloud.uvt.example
# UVT_ELEVEN_PUBLIC_URL=https://eleven.uvt.example
# Необязательно: другой путь к JSON настроек web-панели.
# UVT_SETTINGS_PATH=/home/uvt/.config/uvt/server-settings.json
# На Apple Silicon по умолчанию используется local-balanced.
# На Linux VPS оставьте free-vps.
# UVT_FREE_PROFILE=local-balanced
